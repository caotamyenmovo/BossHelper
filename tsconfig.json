{
  "extends": "./.wxt/tsconfig.json",
  "include": ["src/**/*", ".wxt/**/*.d.ts", "auto-imports.d.ts", "components.d.ts", "wxt.config.ts"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowArbitraryExtensions": true,
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "~": ["./src"],
      "~/*": ["./src/*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"],
      "devlog-ui": ["./packages/devlog-ui/src"]
    }
  }
}
